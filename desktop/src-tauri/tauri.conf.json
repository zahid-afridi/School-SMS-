{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SchoolSMS",
  "version": "1.0.3",
  "identifier": "com.schoolsms.desktop",
  "build": {
    "beforeDevCommand": "node ./scripts/serve-splash.mjs",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node ./scripts/copy-splash.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "School SmS",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/app-payload.zip",
      "resources/node-runtime.zip",
      "resources/bundle-manifest.json",
      "resources/vc_redist.x64.exe"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "displayLanguageSelector": false,
        "startMenuFolder": "SchoolSMS"
      }
    }
  },
  "plugins": {}
}
