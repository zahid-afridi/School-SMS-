{
  "name": "school-sms-desktop",
  "version": "1.1.1",
  "private": true,
  "description": "School (SmS) desktop shell (Electron + local services)",
  "author": "School SmS",
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "start": "node ./scripts/run-desktop.mjs",
    "start:prod": "node ./scripts/run-desktop.mjs --mode=prod",
    "dev": "electron .",
    "prebuild": "node ./scripts/check-bundle-resources.mjs",
    "build": "electron-builder --win nsis",
    "pack": "electron-builder --dir",
    "services:dev": "node ./scripts/launch-services.mjs --mode=dev",
    "services:prod": "node ./scripts/launch-services.mjs --mode=prod",
    "services:stop": "node ./scripts/stop-services.mjs",
    "splash": "node ./scripts/serve-splash.mjs",
    "prepare:splash": "node ./scripts/copy-splash.mjs",
    "prepare:backend": "npm --prefix ../backend run prisma:generate && npm --prefix ../backend run build",
    "prepare:frontend": "node ./scripts/build-frontend.mjs",
    "prepare:bundle": "node ./scripts/prepare-bundle.mjs",
    "prepare:all": "npm run prepare:backend && npm run prepare:frontend && npm run prepare:splash",
    "build:all": "npm run prepare:all && npm --prefix ../OpenWA run build && npm run prepare:bundle && npm run build"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.schoolsms.desktop",
    "productName": "SchoolSMS",
    "copyright": "Copyright © School SmS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "splash.js",
      "package.json",
      "node_modules/adm-zip/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/app-payload.zip",
        "to": "app-payload.zip"
      },
      {
        "from": "resources/node-runtime.zip",
        "to": "node-runtime.zip"
      },
      {
        "from": "resources/bundle-manifest.json",
        "to": "bundle-manifest.json"
      },
      {
        "from": "resources/vc_redist.x64.exe",
        "to": "vc_redist.x64.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "SchoolSMS_${version}_x64-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SchoolSMS",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "asar": true
  }
}
