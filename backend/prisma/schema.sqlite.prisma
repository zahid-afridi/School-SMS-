generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-sqlite"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
}

model School {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?  @unique
  website   String?
  logoUrl   String?
  coverUrl  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]

  @@index([name])
}

model User {
  id         String   @id @default(cuid())
  firstName  String?
  lastName   String?
  email      String   @unique
  username   String?  @unique
  password   String
  role       UserRole

  schoolId   String?
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  isActive   Boolean  @default(true)
  isVerified Boolean  @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([schoolId])
  @@index([role])
}
