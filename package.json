{
  "name": "school-sms",
  "private": true,
  "version": "1.0.0",
  "description": "School (SmS) monorepo helpers",
  "scripts": {
    "desktop": "node ./desktop/scripts/run-desktop.mjs",
    "desktop:prod": "node ./desktop/scripts/run-desktop.mjs --mode=prod",
    "desktop:stop": "node ./desktop/scripts/stop-services.mjs",
    "desktop:dev": "npm --prefix ./desktop run dev",
    "desktop:electron:dev": "npm --prefix ./desktop run dev",
    "desktop:electron:build": "npm --prefix ./desktop run build",
    "desktop:build": "cmd /c desktop\\build.bat"
  }
}
